# confmcp 배포 환경변수 예시.
# cp deploy/.env.example deploy/.env 로 복사한 뒤 값을 채우십시오.

# 이미지 태그 (confmcp:v<버전>)
CONFMCP_VERSION=0.1.0

# 서비스 노출 포트
CONFMCP_PORT=8080

# PostgreSQL
POSTGRES_USER=confmcp
POSTGRES_PASSWORD=
POSTGRES_DB=confmcp

# 최초 관리자 계정 (관리 콘솔 로그인용)
BOOTSTRAP_ADMIN=admin
BOOTSTRAP_ADMIN_PASSWORD=

# 저장되는 모든 비밀값을 암호화하는 32바이트 키.
# 생성 예: openssl rand -base64 32
# 분실하면 저장된 Keycloak Client Secret, Confluence 서비스 계정 비밀번호, 권한 플러그인 비밀, 사용자 위임 자격증명을 복호화할 수 없습니다.
ENCRYPTION_KEY=
